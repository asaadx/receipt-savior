# Vite proxies /api here. Avoid 3000/3001: VS Code Live Preview squats on them.
PORT=4000

# Only the selected provider's key is required; the server won't start without it.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06

# OAuth client id from Google Cloud Console. A client id is not a secret.
VITE_GOOGLE_CLIENT_ID=

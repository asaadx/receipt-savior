# Port the Express API listens on. Vite proxies /api here in development.
PORT=3000

# Which multimodal model extracts line items. Only the selected provider's API
# key is required; the server refuses to start if it is missing.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06

# OAuth client id from Google Cloud Console. VITE_ prefix exposes it to the
# browser bundle, which is correct — a client id is not a secret.
VITE_GOOGLE_CLIENT_ID=

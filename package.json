{
  "name": "receipt-savior",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^7.15.0",
    "zod": "^4.6.2"
  }
}
